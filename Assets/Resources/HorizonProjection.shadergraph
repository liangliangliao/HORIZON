    "m_SourceType": 1,
    "m_FunctionName": "HorizonProjection",
    "m_FunctionSource": "",
    "m_FunctionBody": "float scan = .72 + .28 * step(.82, frac(UV.y * 36 - Clock * .9));\nfloat grain = frac(sin(dot(floor(UV * 80), float2(12.9898,78.233))) * 43758.5453);\nfloat visible = step(grain, saturate(Reveal) * 1.06 - .03);\nfloat edge = 1 - smoothstep(0,.08,abs(grain-Reveal));\nRGB = Tint.rgb * scan + edge * (1-Reveal) * float3(1,.65,.2);\nAlpha = Tint.a * visible * saturate(Reveal*5) * scan;"
}

