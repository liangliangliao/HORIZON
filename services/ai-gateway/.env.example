# Load on the server with: node --env-file=.env server.mjs
# Never commit real credentials or include this file in a Unity build.
HORIZON_GATEWAY_TOKEN=replace-with-a-long-random-private-access-token
HOST=127.0.0.1
PORT=8787
DEEPSEEK_API_KEY=
DEEPSEEK_ENDPOINT=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com
# Foundry project endpoints are also accepted (same resource origin).
# auto | openai | foundry | v1; this sets preference, 404/405 can try another path.
AZURE_ACCESS_MODE=auto
# Optional comma-separated list (max 6). Empty attempts /openai/v1/models.
AZURE_OPENAI_DEPLOYMENT=
# Empty uses defaults per API. v1 does not need a dated version.
AZURE_OPENAI_API_VERSION=
